{
  "name": "corvo-procurement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "tsx server/src/main.ts",
    "migrate": "tsx server/src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test engine/test/*.test.ts server/test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "test:worked": "tsx --test engine/test/worked-examples.test.ts",
    "report:worked": "tsx scripts/report-worked.ts",
    "reset:demo": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
