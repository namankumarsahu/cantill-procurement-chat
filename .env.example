DATABASE_URL=postgresql://corvo:corvo@localhost:5432/corvo
PORT=3000
# Required for imports on a publicly accessible instance. Leave blank for loopback development only.
ADMIN_TOKEN=
# Optional OpenAI-compatible policy parsing; never used for routing.
# Use a /v1 (or provider-equivalent) base URL. No key: use the manual JSON editor.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Default strict json_schema; set json_object for providers without schema mode.
LLM_RESPONSE_FORMAT=json_schema
