DATABASE_URL=postgresql://corvo:corvo@localhost:5432/corvo
PORT=3000
# Local Compose default only. Replace with a random secret for any hosted service.
ADMIN_TOKEN=local-demo-only-change-me
# Compose publishes on loopback only; change if port 3000 is already in use.
APP_PORT=3000
# Enables the authenticated reset API on disposable demos only. Leave false normally.
ALLOW_DEMO_RESET=false
# UI default; may be changed in the app without affecting decisions.
EXPORT_FILENAME_PREFIX=yourname
# Optional OpenAI-compatible policy parsing; never used for routing.
# Use a /v1 (or provider-equivalent) base URL. No key: use the manual JSON editor.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Default strict json_schema; set json_object for providers without schema mode.
LLM_RESPONSE_FORMAT=json_schema
